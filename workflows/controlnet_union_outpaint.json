    "inputs": {
      "image": ["2", 0],
      "left": 200, "top": 0, "right": 200, "bottom": 0,
      "feathering": 0
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "seamless natural extension, matching texture, photorealistic", "clip": ["1", 1] }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "new objects, people, animals, visible seam, artifacts, blurry", "clip": ["1", 1] }
  },
  "10": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "xinsir_union_promax.safetensors" }
  },
  "11": {
    "class_type": "SetUnionControlNetType",
    "inputs": { "control_net": ["10", 0], "type": "repaint" }
