  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0], "positive": ["12", 0], "negative": ["12", 1],
      "latent_image": ["6", 0], "seed": 42,
      "steps": 26, "cfg": 4.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["7", 0], "vae": ["1", 2] }
  },
  "30": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["8", 0], "source": ["3", 0], "mask": ["20", 0],
      "x": 0, "y": 0, "resize_source": false
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "images": ["30", 0], "filename_prefix": "outpaint_result" }
  }
}
